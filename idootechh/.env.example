# Supabase (https://app.supabase.com -> project settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail sender (enable 2-Step Verification, then create an App Password)
SMTP_USER=
SMTP_PASS=

# Where contact form emails are delivered
CONTACT_RECIPIENT=info@idootech.com.ng

# Secret token to view saved messages: GET /.netlify/functions/messages with header x-admin-token
ADMIN_TOKEN=
